#!/usr/bin/env python3
"""E2E test runner for ef editor validation."""

import importlib.util
import os
import shutil
import sys
import tempfile


SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
CASES_DIR = os.path.join(SCRIPT_DIR, "cases")
DEBUG = False


def usage():
    print("Usage:")
    print("  e2e [--debug] run <test-case-name> <ef-executable-path>")
    print("  e2e [--debug] run-all <ef-executable-path>")
    sys.exit(1)


def execute_test(name, ef_path):
    """Run a single test case in an isolated temp directory.

    Returns None on success, error message string on failure.
    """
    case_dir = os.path.join(CASES_DIR, name)

    if not os.path.isdir(case_dir):
        return f"Test case not found: {name}"

    scenario_path = os.path.join(case_dir, "scenario.py")
    if not os.path.isfile(scenario_path):
        return f"Missing scenario.py in test case: {name}"

    temp_dir = tempfile.mkdtemp(prefix=f"{name}-")
    original_cwd = os.getcwd()

    try:
        # Copy test case contents to temp directory
        for item in os.listdir(case_dir):
            src = os.path.join(case_dir, item)
            dst = os.path.join(temp_dir, item)
            if os.path.isdir(src):
                shutil.copytree(src, dst)
            else:
                shutil.copy2(src, dst)

        os.chdir(temp_dir)

        # Load scenario.py dynamically
        spec = importlib.util.spec_from_file_location("scenario", os.path.join(temp_dir, "scenario.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)

        if not hasattr(module, "run"):
            return f"scenario.py in '{name}' has no run() function"

        module.run(ef_path)
        return None

    except BaseException as e:
        return str(e)

    finally:
        os.chdir(original_cwd)
        if DEBUG:
            print(f"  temp dir: {temp_dir}")
        else:
            shutil.rmtree(temp_dir, ignore_errors=True)


def run_single_test(name, ef_path):
    """Run one test case and print result."""
    error = execute_test(name, ef_path)
    if error is None:
        print("OK")
        sys.exit(0)
    else:
        print(error)
        sys.exit(1)


def discover_tests():
    """List sorted test case subdirectories."""
    if not os.path.isdir(CASES_DIR):
        return []
    return sorted(
        d for d in os.listdir(CASES_DIR)
        if os.path.isdir(os.path.join(CASES_DIR, d))
    )


def run_all_tests(ef_path):
    """Run all test cases and print line-by-line results with summary."""
    tests = discover_tests()

    if not tests:
        print("No test cases found in tests/cases/")
        sys.exit(0)

    passed = 0
    total = len(tests)

    for name in tests:
        error = execute_test(name, ef_path)
        if error is None:
            print(f"{name}: OK")
            passed += 1
        else:
            print(f"{name}: FAIL - {error}")

    print(f"{passed}/{total} passed")

    if passed < total:
        sys.exit(1)
    else:
        sys.exit(0)


def main():
    global DEBUG

    args = sys.argv[1:]

    if "--debug" in args:
        DEBUG = True
        args.remove("--debug")

    if len(args) < 1:
        usage()

    command = args[0]

    if command == "run" and len(args) == 3:
        name = args[1]
        ef_path = os.path.abspath(args[2])
        if not os.path.isfile(ef_path):
            print(f"ef executable not found: {ef_path}")
            sys.exit(1)
        run_single_test(name, ef_path)

    elif command == "run-all" and len(args) == 2:
        ef_path = os.path.abspath(args[1])
        if not os.path.isfile(ef_path):
            print(f"ef executable not found: {ef_path}")
            sys.exit(1)
        run_all_tests(ef_path)

    else:
        usage()


if __name__ == "__main__":
    main()
