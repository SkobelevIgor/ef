{
	"file_types": {
		"go": {
			"extensions": [".go"],
			"syntax_highlighting": true,
			"tabstop": 4,
			"shiftwidth": 4,
			"autoindentation": true,
			"expandtab": false,
			"tokenizer": {
				"keywords": ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"],
				"line_comment": "//",
				"block_comment": ["/*", "*/"],
				"strings": [
					{"open": "`", "close": "`"},
					{"open": "\"", "close": "\"", "escape": "\\"},
					{"open": "'", "close": "'", "escape": "\\"}
				],
				"brackets": "()[]{}",
				"styles": {
					"keyword":       {"color": "yellow"},
					"string":        {"color": "green"},
					"comment":       {"color": "gray"},
					"function_call": {"color": "yellow"},
					"bracket":       {"color": "purple"},
					"number":        {"color": "blue", "bold": true}
				}
			}
		},
		"python": {
			"extensions": [".py", ".pyw"],
			"syntax_highlighting": true,
			"tabstop": 4,
			"shiftwidth": 4,
			"autoindentation": true,
			"expandtab": true,
			"tokenizer": {
				"keywords": ["and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "None", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"],
				"line_comment": "#",
				"strings": [
					{"open": "\"\"\"", "close": "\"\"\""},
					{"open": "'''", "close": "'''"},
					{"open": "\"", "close": "\"", "escape": "\\"},
					{"open": "'", "close": "'", "escape": "\\"}
				],
				"brackets": "()[]{}",
				"styles": {
					"keyword":       {"color": "blue", "bold": true},
					"string":        {"color": "green"},
					"comment":       {"color": "gray"},
					"function_call": {"color": "yellow"},
					"bracket":       {"color": "purple"},
					"number":        {"color": "yellow"}
				}
			}
		},
		"javascript/typescript": {
			"extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx"],
			"syntax_highlighting": true,
			"tabstop": 2,
			"shiftwidth": 2,
			"autoindentation": true,
			"expandtab": true,
			"tokenizer": {
				"keywords": ["abstract", "as", "async", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "declare", "default", "delete", "do", "else", "enum", "export", "extends", "finally", "for", "from", "function", "if", "implements", "import", "in", "instanceof", "interface", "let", "module", "namespace", "never", "new", "of", "private", "protected", "public", "readonly", "return", "static", "super", "switch", "this", "throw", "try", "type", "typeof", "unknown", "var", "void", "while", "with", "yield"],
				"line_comment": "//",
				"block_comment": ["/*", "*/"],
				"strings": [
					{"open": "`", "close": "`"},
					{"open": "\"", "close": "\"", "escape": "\\"},
					{"open": "'", "close": "'", "escape": "\\"}
				],
				"brackets": "()[]{}",
				"styles": {
					"keyword":       {"color": "blue", "bold": true},
					"string":        {"color": "green"},
					"comment":       {"color": "gray"},
					"function_call": {"color": "yellow"},
					"bracket":       {"color": "purple"},
					"number":        {"color": "yellow"}
				}
			}
		}
	},
	"maps": {
		"{{": "{}<Esc>ha<Enter><Esc>ko<Tab>",
		"((": "()<Esc>ha",
		"[[": "[]<Esc>ha",
		"\"\"": "\"\"<Esc>ha",
		"''": "''<Esc>ha",
		"``": "``<Esc>ha"
	}
}
